@using BudgetWise.Mobile.Models
@using BudgetWise.Mobile.Services
@inject AuthService AuthService

<FormContainer TDto="ReminderDto"
               Model="Reminder"
               ApiEndpoint="api/reminder"
               Title="Reminder"
               OnSaved="OnSaved"
               OnCancelled="OnCancelled">

    <div class="mb-3">
        <label class="form-label">Message</label>
        <InputText class="form-control"
                   @bind-Value="Reminder.Message" />
    </div>
    <div class="mb-3">
        <label class="form-label">Remind At</label>
        <InputDate class="form-control"
                   @bind-Value="Reminder.RemindAt" />
    </div>

</FormContainer>

@code {
    [Parameter] public ReminderDto Reminder { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Reminder.RemindAt == DateTime.MinValue)
            Reminder.RemindAt = DateTime.Now;

        var uid = await AuthService.GetUserIdFromToken();
        if (uid.HasValue && (Reminder.UserId == 0 || Reminder.UserId == null))
            Reminder.UserId = uid.Value;
    }
}