@using BudgetWise.Mobile.Models
@using BudgetWise.Mobile.Services
@inject AuthService AuthService

<FormContainer TDto="GoalDto"
               Model="Goal"
               ApiEndpoint="api/savinggoal"
               Title="Goal"
               OnSaved="OnSaved"
               OnCancelled="OnCancelled">

    <div class="mb-3">
        <label class="form-label">Title</label>
        <InputText class="form-control"
                   @bind-Value="Goal.Title" />
    </div>
    <div class="mb-3">
        <label class="form-label">Target Amount</label>
        <InputNumber class="form-control"
                     @bind-Value="Goal.TargetAmount" />
    </div>
    <div class="mb-3">
        <label class="form-label">Currency</label>
        <InputSelect class="form-select"
                     @bind-Value="Goal.Currency">
            @foreach (var cur in FormContainer<GoalDto>.Lookups.Currencies)
            {
                <option value="@cur">@cur</option>
            }
        </InputSelect>
    </div>
    <div class="mb-3">
        <label class="form-label">Deadline</label>
        <InputDate class="form-control"
                   @bind-Value="Goal.Deadline" />
    </div>

</FormContainer>

@code {
    [Parameter] public GoalDto Goal { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (Goal.Deadline == DateTime.MinValue)
            Goal.Deadline = DateTime.Today;

        var uid = await AuthService.GetUserIdFromToken();
        if (uid.HasValue && Goal.UserId == 0)
            Goal.UserId = uid.Value;
    }
}