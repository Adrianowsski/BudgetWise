@page "/dashboard"
@layout MainLayout

@using System.Linq
@using BudgetWise.Mobile.Components.Layout
@using BudgetWise.Mobile.Models
@using BudgetWise.Mobile.Services
@using BudgetWise.Mobile.Shared   @* żeby widzieć SummaryCard *@

@inject ApiService Api
@inject AuthService AuthService
@inject IJSRuntime JS

<link href="css/css/Dashboard/dashboard.css" rel="stylesheet" />

<h3 class="mb-4">Dashboard</h3>

@if (!string.IsNullOrEmpty(_error))
{
  <div class="alert alert-danger">@_error</div>
}
else if (_loading)
{
  <p>Ładowanie danych…</p>
}
else
{
  <!-- KPI Cards -->
  <div class="row summary-cards mb-4">
    <div class="col-sm-3">
      <SummaryCard Title="Total Expenses" Value="@_totalExpenses.ToString("C")" />
    </div>
    <div class="col-sm-3">
      <SummaryCard Title="Total Incomes"  Value="@_totalIncomes.ToString("C")"  />
    </div>
    <div class="col-sm-3">
      <SummaryCard Title="Subs/mo." Value="@_subsMonthly.ToString("C")" />
    </div>
    <div class="col-sm-3">
      <SummaryCard Title="Balance"
        Value="@( (_totalIncomes - _totalExpenses - _subsMonthly).ToString("C") )" />
    </div>
  </div>

  <!-- Charts -->
  <div class="row mb-5">
    <div class="col-md-6">
      <div class="card p-3">
        <h6>Income vs Expenses (6m)</h6>
        <canvas id="lineChart"></canvas>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card p-3">
        <h6>Expenses by Category</h6>
        <canvas id="pieChart"></canvas>
      </div>
    </div>
  </div>

  <!-- Subscriptions & Reminders -->
  <div class="row">
    <div class="col-md-6 mb-4">
      <h6>Subscriptions</h6>
      <ul class="list-group">
        @foreach (var s in _subs)
        {
          <li class="list-group-item d-flex justify-content-between">
            <span>@s.Title</span>
            <span>@GetMonthlyCost(s).ToString("C")</span>
          </li>
        }
      </ul>
    </div>
    <div class="col-md-6 mb-4">
      <h6>Upcoming Reminders</h6>
      <ul class="list-group">
        @foreach (var r in _reminders.OrderBy(r => r.RemindAt).Take(5))
        {
          <li class="list-group-item">
            @r.Message
            <small class="text-muted float-end">@r.RemindAt:g</small>
          </li>
        }
      </ul>
    </div>
  </div>
}

@code {
  private List<ExpenseDto>          _expenses   = new();
  private List<IncomeDto>           _incomes    = new();
  private List<RecurringExpenseDto> _subs       = new();
  private List<ReminderDto>         _reminders  = new();
  private bool                      _loading    = true;
  private string?                   _error;

  private decimal _totalExpenses;
  private decimal _totalIncomes;
  private decimal _subsMonthly;

  // Chart data:
  private string[]   _labels6 = Array.Empty<string>();
  private decimal[]  _dataInc = Array.Empty<decimal>();
  private decimal[]  _dataExp = Array.Empty<decimal>();
  private string[]   _pieLabels = Array.Empty<string>();
  private decimal[]  _pieData   = Array.Empty<decimal>();

  protected override async Task OnInitializedAsync()
  {
    try
    {
      // Jeśli ApiService sam dokłada auth header, nie musisz nic ustawiać tutaj
      var userId = await AuthService.GetUserIdFromToken();
      _expenses  = await Api.GetListAsync<ExpenseDto>("api/expense");
      _incomes   = await Api.GetListAsync<IncomeDto>("api/income");
      _subs      = await Api.GetListAsync<RecurringExpenseDto>("api/recurringexpense");
      _reminders = await Api.GetListAsync<ReminderDto>("api/reminder");

      // KPI
      _totalExpenses = _expenses.Sum(e => e.Amount);
      _totalIncomes  = _incomes.Sum(i => i.Amount);
      _subsMonthly   = _subs.Sum(GetMonthlyCost);

      PrepareCharts();
    }
    catch (Exception ex)
    {
      _error = ex.Message;
    }
    finally
    {
      _loading = false;
    }
  }

  void PrepareCharts()
  {
    var today = DateTime.Today;

    // line chart – last 6 months
    var labels = new List<string>();
    var incs   = new List<decimal>();
    var exps   = new List<decimal>();
    for (int m = 5; m >= 0; m--)
    {
      var dt = today.AddMonths(-m);
      labels.Add(dt.ToString("MMM yy"));
      incs.Add(_incomes.Where(i => i.Date.Year == dt.Year && i.Date.Month == dt.Month).Sum(i => i.Amount));
      exps.Add(_expenses.Where(e => e.Date.Year == dt.Year && e.Date.Month == dt.Month).Sum(e => e.Amount));
    }
    _labels6 = labels.ToArray();
    _dataInc = incs.ToArray();
    _dataExp = exps.ToArray();

    // pie chart – this month by category
    var grouped = _expenses
      .Where(e => e.Date.Year == today.Year && e.Date.Month == today.Month)
      .GroupBy(e => e.CategoryName)
      .ToDictionary(g => g.Key, g => g.Sum(x => x.Amount));

    _pieLabels = grouped.Keys.ToArray();
    _pieData   = grouped.Values.ToArray();
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender || _loading) return;

    // rysuj line
    await JS.InvokeVoidAsync("renderLineChart",
      "lineChart",
      _labels6,
      new object[]
      {
        new { label = "Income",  data = _dataInc, borderColor = "green", fill = false },
        new { label = "Expenses", data = _dataExp, borderColor = "red",   fill = false }
      });

    // rysuj pie
    await JS.InvokeVoidAsync("renderPieChart",
      "pieChart",
      _pieLabels,
      _pieData);
  }

  decimal GetMonthlyCost(RecurringExpenseDto r) => r.Frequency switch
  {
    "Daily"     => r.Amount * 30,
    "Weekly"    => r.Amount * 4,
    "Monthly"   => r.Amount,
    "Quarterly" => r.Amount / 3,
    "Yearly"    => r.Amount / 12,
    _           => r.Amount
  };
}
