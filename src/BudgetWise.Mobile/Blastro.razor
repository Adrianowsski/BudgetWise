@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using BudgetWise.Mobile.Components.Layout

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(Blastro).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <div class="container mt-4">
                        <h3>🔒 Access Denied</h3>
                        <p>You must be logged in to access this page.</p>
                        <NavLink href="/login" class="btn btn-primary">Go to Login</NavLink>
                    </div>
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p class="text-danger">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>