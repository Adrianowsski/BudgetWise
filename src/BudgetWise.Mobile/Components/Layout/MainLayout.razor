@using BudgetWise.Mobile.Services
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@inject AuthService AuthService
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized>
        <div class="layout">
            <!-- Navbar -->
            <div class="navbar bg-gradient text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="text-white m-0">BudgetWise</h4>
                    <!-- Przycisk do otwierania sidebaru (prawy górny róg) -->
                    <button class="btn btn-dark toggle-button" @onclick="ToggleSidebar">
                        ☰
                    </button>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="sidebar bg-dark text-white p-3 @(_isSidebarOpen ? "open" : "")"> 
                <div class="sidebar-header d-flex justify-content-between align-items-center mb-4">
                    <h4 class="text-white">BudgetWise</h4>
                    <button class="btn btn-sm btn-light" @onclick="ToggleSidebar">✕</button>
                </div>

                <!-- Navigation Links -->
                <nav class="nav flex-column">
                    <NavLink href="/dashboard" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-home"></i> Dashboard
                    </NavLink>
                    <NavLink href="/expenses" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-money-bill"></i> Expenses
                    </NavLink>
                    <NavLink href="/incomes" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-wallet"></i> Incomes
                    </NavLink>
                    <NavLink href="/budgets" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-chart-pie"></i> Budgets
                    </NavLink>
                    <NavLink href="/categories" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-list"></i> Expense Categories
                    </NavLink>
                    <NavLink href="/income-types" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-tag"></i> Income Types
                    </NavLink>
                    <NavLink href="/goals" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-bullseye"></i> Goals
                    </NavLink>
                    <NavLink href="/reminders" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-bell"></i> Reminders
                    </NavLink>
                    <NavLink href="/subscriptions" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-repeat"></i> Subscriptions
                    </NavLink>
                    <NavLink href="/payment-methods" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-credit-card"></i> Payment Methods
                    </NavLink>

                    <!-- Logout Button -->
                    <button class="btn btn-danger mt-3 w-100" @onclick="Logout">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </button>
                </nav>
            </div>

            <!-- Main Content -->
            <div class="main-content">
                @Body
            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="layout">
            <div class="navbar bg-gradient text-white p-3">
                <div class="d-flex justify-content-between align-items-center">
                    <h4 class="text-white m-0">BudgetWise</h4>
                    <!-- Przycisk do otwierania sidebaru (prawy górny róg) -->
                    <button class="btn btn-dark toggle-button" @onclick="ToggleSidebar">
                        ☰
                    </button>
                </div>
            </div>

            <!-- Sidebar for Guests -->
            <div class="sidebar bg-dark text-white p-3 @(_isSidebarOpen ? "open" : "")">
                <div class="sidebar-header d-flex justify-content-between align-items-center mb-4">
                    <h4 class="text-white">BudgetWise</h4>
                    <button class="btn btn-sm btn-light" @onclick="ToggleSidebar">✕</button>
                </div>

                <!-- Guest Links -->
                <nav class="nav flex-column">
                    <NavLink href="/login" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-sign-in-alt"></i> Login
                    </NavLink>
                    <NavLink href="/register" class="nav-link" @onclick="CloseSidebar">
                        <i class="fas fa-user-plus"></i> Register
                    </NavLink>
                </nav>
            </div>

            <div class="main-content">
                @Body
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _isSidebarOpen;

    private void ToggleSidebar() => _isSidebarOpen = !_isSidebarOpen;
    private void CloseSidebar() => _isSidebarOpen = false;

    private async Task Logout()
    {
        await AuthService.Logout();
        Navigation.NavigateTo("/", true);
    }
}
