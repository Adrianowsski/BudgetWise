@page "/categories"
@using BudgetWise.Mobile.Models
@using BudgetWise.Mobile.Services
@inject ApiService ApiService

<CrudComponent TItem="CategoryDto"
               Title="Expense Categories"
               AddButtonText="Add Category"
               Subtitle="Organize your spending by category."
               Items="@categories"
               ErrorMessage="@error"
               ShowForm="@showForm"
               ShowFormChanged="@(v => showForm = v)"
               OnAdd="PrepareNew"
               OnEdit="PrepareEdit"
               OnDelete="ConfirmDelete">

  <RowTemplate Context="c">
    <div class="pm-row"><div class="pm-label">Name</div><div class="pm-value">@c.Name</div></div>
    <div class="pm-row"><div class="pm-label">Icon</div><div class="pm-value">@c.Icon</div></div>
  </RowTemplate>

  <FormTemplate Context="c">
    <CategoryForm Category="c"
                  OnSaved="OnSaved"
                  OnCancelled="()=> showForm = false" />
  </FormTemplate>

  <EmptyTemplate>
    <p class="text-center text-secondary">No categories defined.</p>
  </EmptyTemplate>
</CrudComponent>

@code {
  private List<CategoryDto>? categories;
  private bool showForm;
  private string? error;

  protected override async Task OnInitializedAsync() => await Load();

  private async Task Load()
  {
    try
    {
      categories = await ApiService.GetListAsync<CategoryDto>("api/expensecategory");
      error = null;
    }
    catch (Exception ex)
    {
      error = $"Failed to load categories: {ex.Message}";
    }
  }

  private Task PrepareNew() => Task.CompletedTask;
  private Task PrepareEdit(CategoryDto c) => Task.CompletedTask;

  private async Task ConfirmDelete(CategoryDto c)
  {
    if (!await Confirm("Delete this category?")) return;
    if (await ApiService.DeleteAsync($"api/expensecategory/{c.Id}"))
      await Load();
    else
      error = "Error deleting category.";
  }

  private async Task OnSaved()
  {
    showForm = false;
    await Load();
  }

  private Task<bool> Confirm(string _) => Task.FromResult(true);
}
