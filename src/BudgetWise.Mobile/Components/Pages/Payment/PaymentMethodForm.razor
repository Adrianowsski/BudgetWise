@using BudgetWise.Mobile.Models
@using BudgetWise.Mobile.Services

<FormContainer TDto="PaymentMethodDto"
               Model="Method"
               ApiEndpoint="api/paymentmethod"
               Title="Payment Method"
               OnSaved="OnSaved"
               OnCancelled="OnCancelled">

    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control"
                   @bind-Value="Method.Name" />
    </div>
    <div class="mb-3">
        <label class="form-label">Type</label>
        <InputText class="form-control"
                   @bind-Value="Method.Type" />
    </div>
    <div class="mb-3">
        <label class="form-label">Provider</label>
        <InputText class="form-control"
                   @bind-Value="Method.Provider" />
    </div>

</FormContainer>

@code {
    [Parameter] public PaymentMethodDto Method { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }
}