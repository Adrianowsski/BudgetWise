@page "/incomes"
@using BudgetWise.Mobile.Models
@using BudgetWise.Mobile.Services
@inject ApiService Api

<CrudComponent TItem="IncomeDto"
               Title="Incomes"
               AddButtonText="Add Income"
               Subtitle="Record and review your income entries."
               Items="@incomes"
               ErrorMessage="@error"
               ShowForm="@showForm"
               ShowFormChanged="@(v => showForm = v)"
               OnAdd="PrepareNew"
               OnEdit="PrepareEdit"
               OnDelete="ConfirmDelete">

  <RowTemplate Context="i">
    <div class="pm-row"><div class="pm-label">Source</div><div class="pm-value">@i.Source</div></div>
    <div class="pm-row"><div class="pm-label">Amount</div><div class="pm-value">@($"{i.Amount:N2} {i.Currency}")</div></div>
    <div class="pm-row"><div class="pm-label">Date</div><div class="pm-value">@i.Date.ToShortDateString()</div></div>
    <div class="pm-row"><div class="pm-label">Type</div><div class="pm-value">@i.IncomeTypeName</div></div>
  </RowTemplate>

  <FormTemplate Context="i">
    <IncomeForm Income="i"
                OnSaved="OnSaved"
                OnCancelled="()=> showForm = false" />
  </FormTemplate>

  <EmptyTemplate>
    <p class="text-center text-secondary">No incomes yet. ➕ Add the first one.</p>
  </EmptyTemplate>
</CrudComponent>

@code {
  private List<IncomeDto>? incomes;
  private bool showForm;
  private string? error;

  protected override async Task OnInitializedAsync() => await Load();

  private async Task Load()
  {
    try
    {
      incomes = await Api.GetListAsync<IncomeDto>("api/income");
      error = null;
    }
    catch (Exception ex)
    {
      error = $"Failed to load incomes: {ex.Message}";
    }
  }

  private Task PrepareNew() => Task.CompletedTask;
  private Task PrepareEdit(IncomeDto i) => Task.CompletedTask;

  private async Task ConfirmDelete(IncomeDto i)
  {
    if (!await Confirm("Delete this income?")) return;
    if (await Api.DeleteAsync($"api/income/{i.Id}"))
      await Load();
    else
      error = "Error deleting income.";
  }

  private async Task OnSaved()
  {
    showForm = false;
    await Load();
  }

  private Task<bool> Confirm(string _) => Task.FromResult(true);
}
