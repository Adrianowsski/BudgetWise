@page "/register"
@using BudgetWise.Mobile.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<link rel="stylesheet" href="css/css/Register/register.css" />

<div class="register-container">
    <h3>Register</h3>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger">@_error</div>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
        <div class="alert alert-success">@_success</div>
    }

    <EditForm Model="_registerModel" OnValidSubmit="HandleRegister">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="input-group mb-3">
            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
            <InputText class="form-control" placeholder="Email" @bind-Value="_registerModel.Email" />
        </div>

        <div class="input-group mb-3">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <InputText class="form-control" placeholder="Password" type="password" @bind-Value="_registerModel.Password" />
        </div>

        <div class="input-group mb-3">
            <span class="input-group-text"><i class="fas fa-lock"></i></span>
            <InputText class="form-control" placeholder="Confirm Password" type="password" @bind-Value="_registerModel.ConfirmPassword" />
        </div>

        <button class="btn btn-primary w-100" type="submit">Register</button>

        <p class="mt-3 text-center">Already have an account? <a href="/login">Login here</a></p>
    </EditForm>
</div>

@code {
    private RegisterModel _registerModel = new();
    private string? _error;
    private string? _success;

    private async Task HandleRegister()
    {
        _error = _success = null;

        if (_registerModel.Password != _registerModel.ConfirmPassword)
        {
            _error = "Passwords do not match.";
            return;
        }

        var errorMessage = await AuthService.Register(_registerModel.Email, _registerModel.Password);
        if (string.IsNullOrEmpty(errorMessage))
        {
            _success = "Account created successfully. You can now log in.";
            Navigation.NavigateTo("/login", true);
        }
        else
        {
            _error = errorMessage;
        }
    }

    private class RegisterModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
