@page "/subscriptions"
@using BudgetWise.Mobile.Models
@using BudgetWise.Mobile.Services
@inject ApiService Api
@inject AuthService AuthService

<CrudComponent TItem="RecurringExpenseDto"
               Title="Subscriptions"
               AddButtonText="Add Subscription"
               Subtitle="Manage your recurring expenses."
               Items="@items"
               ErrorMessage="@error"
               ShowForm="@showForm"
               ShowFormChanged="@(v => showForm = v)"
               OnAdd="CreateNew"
               OnEdit="PrepareEdit"
               OnDelete="ConfirmDelete">

  <RowTemplate Context="sub">
    <div class="pm-row">
      <div class="pm-label">Title</div>
      <div class="pm-value">@sub.Title</div>
    </div>
    <div class="pm-row">
      <div class="pm-label">Amount</div>
      <div class="pm-value">@($"{sub.Amount:N2} {sub.Currency}")</div>
    </div>
    <div class="pm-row">
      <div class="pm-label">Frequency</div>
      <div class="pm-value">@sub.Frequency</div>
    </div>
  </RowTemplate>

  <FormTemplate Context="sub">
    <SubscriptionForm Subscription="sub"
                      OnSaved="HandleSaved"
                      OnCancelled="()=> showForm = false" />
  </FormTemplate>

  <EmptyTemplate>
    <p class="text-center text-secondary">No subscriptions found.</p>
  </EmptyTemplate>
</CrudComponent>

@code {
    private List<RecurringExpenseDto>? items;
    private bool showForm;
    private string? error;

    protected override async Task OnInitializedAsync()
        => await Load();

    private async Task Load()
    {
        try
        {
            items = await Api.GetListAsync<RecurringExpenseDto>("api/recurringexpense");
            error = null;
        }
        catch (Exception ex)
        {
            error = $"Failed to load subscriptions: {ex.Message}";
        }
    }

    private Task CreateNew() => Task.CompletedTask;
    private Task PrepareEdit(RecurringExpenseDto sub) => Task.CompletedTask;

    private async Task ConfirmDelete(RecurringExpenseDto sub)
    {
        if (!await Confirm("Delete this subscription?")) return;

        bool ok = await Api.DeleteAsync($"api/recurringexpense/{sub.Id}");
        if (ok) await Load();
        else    error = "Failed to delete subscription.";
    }

    private async Task HandleSaved()
    {
        showForm = false;
        await Load();
    }

    private Task<bool> Confirm(string _) => Task.FromResult(true);
}
