@page "/budgets"
@using BudgetWise.Mobile.Models
@using BudgetWise.Mobile.Services
@inject ApiService Api

<CrudComponent TItem="BudgetDto"
               Title="Monthly Budgets"
               AddButtonText="Add Budget"
               Subtitle="Plan spending limits per category each month."
               Items="@budgets"
               ErrorMessage="@error"
               ShowForm="@showForm"
               ShowFormChanged="@(v => showForm = v)"
               OnAdd="PrepareNew"
               OnEdit="PrepareEdit"
               OnDelete="ConfirmDelete">

  <RowTemplate Context="b">
    <div class="pm-row"><div class="pm-label">Total</div><div class="pm-value">@($"{b.TotalAmount:N2} {b.Currency}")</div></div>
    <div class="pm-row"><div class="pm-label">Month</div><div class="pm-value">@b.Month:yyyy-MM</div></div>
    <div class="pm-row"><div class="pm-label">Category</div><div class="pm-value">@b.CategoryName</div></div>
  </RowTemplate>

  <FormTemplate Context="b">
    <BudgetForm Budget="b"
                OnSaved="OnSaved"
                OnCancelled="()=> showForm = false" />
  </FormTemplate>

  <EmptyTemplate>
    <p class="text-center text-secondary">No budgets for this month. ➕ Add one.</p>
  </EmptyTemplate>
</CrudComponent>

@code {
  private List<BudgetDto>? budgets;
  private bool showForm;
  private string? error;

  protected override async Task OnInitializedAsync() => await Load();

  private async Task Load()
  {
    try
    {
      budgets = await Api.GetListAsync<BudgetDto>("api/monthlybudget");
      error = null;
    }
    catch (Exception ex)
    {
      error = $"Failed to load budgets: {ex.Message}";
    }
  }

  private Task PrepareNew() => Task.CompletedTask;
  private Task PrepareEdit(BudgetDto b) => Task.CompletedTask;

  private async Task ConfirmDelete(BudgetDto b)
  {
    if (!await Confirm("Delete this budget?")) return;
    if (await Api.DeleteAsync($"api/monthlybudget/{b.Id}"))
      await Load();
    else
      error = "Error deleting budget.";
  }

  private async Task OnSaved()
  {
    showForm = false;
    await Load();
  }

  private Task<bool> Confirm(string _) => Task.FromResult(true);
}
