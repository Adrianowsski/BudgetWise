@using BudgetWise.Mobile.Models
@using BudgetWise.Mobile.Services
@inject AuthService AuthService

<FormContainer TDto="BudgetDto"
               Model="Budget"
               ApiEndpoint="api/monthlybudget"
               Title="Budget"
               OnSaved="OnSaved"
               OnCancelled="OnCancelled">

    <div class="mb-3">
        <label class="form-label">Total Amount</label>
        <InputNumber class="form-control"
                     @bind-Value="Budget.TotalAmount" />
    </div>
    <div class="mb-3">
        <label class="form-label">Currency</label>
        <InputSelect class="form-select"
                     @bind-Value="Budget.Currency">
            @foreach (var cur in FormContainer<BudgetDto>.Lookups.Currencies)
            {
                <option value="@cur">@cur</option>
            }
        </InputSelect>
    </div>
    <div class="mb-3">
        <label class="form-label">Month</label>
        <InputDate class="form-control"
                   @bind-Value="Budget.Month" />
    </div>
    <div class="mb-3">
        <label class="form-label">Category</label>
        <InputSelect class="form-select"
                     @bind-Value="Budget.ExpenseCategoryId">
            <option value="">-- Select Category --</option>
            @if (Categories != null)
            {
                @foreach (var c in Categories)
                {
                    <option value="@c.Id">@($"{c.Icon} {c.Name}")</option>
                }
            }
        </InputSelect>
    </div>

</FormContainer>

@code {
    [Parameter] public BudgetDto Budget { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private List<ExpenseCategoryDto>? Categories;

    protected override async Task OnInitializedAsync()
    {
        Categories = await ApiService.GetListAsync<ExpenseCategoryDto>("api/expensecategory");
        var uid = await AuthService.GetUserIdFromToken();
        if (uid.HasValue && Budget.UserId == 0)
            Budget.UserId = uid.Value;
    }
}